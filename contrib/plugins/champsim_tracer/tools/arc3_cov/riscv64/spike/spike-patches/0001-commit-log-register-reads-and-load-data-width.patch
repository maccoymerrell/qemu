+void vectorUnit_t::log_elt_read_if_needed(reg_t vReg) const {
+  if (unlikely(p->get_log_commits_enabled())) {
+    p->get_state()->log_reg_read[((vReg) << 4) | 2] = {0, 0};
+    auto& snap = p->get_state()->log_vreg_read;
+    if (snap.find(vReg) == snap.end()) {
+      const uint8_t* base =
+          (const uint8_t*)reg_file + vReg * (VLEN >> 3);
+      snap.emplace(vReg, std::vector<uint8_t>(base, base + (VLEN >> 3)));
+    }
+  }
+}
