# *** Vector loads and stores are encoded within LOADFP/STORE-FP ***
# Vector unit-stride load/store insns.
vle8_v     ... 000 . 00000 ..... 000 ..... 0000111 @r2_nfvm !word=vec.load
vle16_v    ... 000 . 00000 ..... 101 ..... 0000111 @r2_nfvm !word=vec.load
vle32_v    ... 000 . 00000 ..... 110 ..... 0000111 @r2_nfvm !word=vec.load
vle64_v    ... 000 . 00000 ..... 111 ..... 0000111 @r2_nfvm !word=vec.load
vse8_v     ... 000 . 00000 ..... 000 ..... 0100111 @r2_nfvm !word=vec.store
vse16_v    ... 000 . 00000 ..... 101 ..... 0100111 @r2_nfvm !word=vec.store
vse32_v    ... 000 . 00000 ..... 110 ..... 0100111 @r2_nfvm !word=vec.store
vse64_v    ... 000 . 00000 ..... 111 ..... 0100111 @r2_nfvm !word=vec.store

# Vector unit-stride mask load/store insns.
vlm_v      000 000 1 01011 ..... 000 ..... 0000111 @r2 !word=vec.load
vsm_v      000 000 1 01011 ..... 000 ..... 0100111 @r2 !word=vec.store

# Vector strided insns.
vlse8_v     ... 010 . ..... ..... 000 ..... 0000111 @r_nfvm !word=vec.load
vlse16_v    ... 010 . ..... ..... 101 ..... 0000111 @r_nfvm !word=vec.load
vlse32_v    ... 010 . ..... ..... 110 ..... 0000111 @r_nfvm !word=vec.load
vlse64_v    ... 010 . ..... ..... 111 ..... 0000111 @r_nfvm !word=vec.load
vsse8_v     ... 010 . ..... ..... 000 ..... 0100111 @r_nfvm !word=vec.store
vsse16_v    ... 010 . ..... ..... 101 ..... 0100111 @r_nfvm !word=vec.store
vsse32_v    ... 010 . ..... ..... 110 ..... 0100111 @r_nfvm !word=vec.store
