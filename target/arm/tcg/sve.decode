FCVTXNT_ds      01100100 00 0010 10 101 ... ..... .....  @rd_pg_rn_e0 !word=fp.cvt
FCVTX_ds        01100101 00 0010 10 101 ... ..... .....  @rd_pg_rn_e0 !word=fp.cvt
FCVTNT_sh       01100100 10 0010 00 101 ... ..... .....  @rd_pg_rn_e0 !word=fp.cvt
BFCVTNT         01100100 10 0010 10 101 ... ..... .....  @rd_pg_rn_e0 !word=fp.cvt
FCVTLT_hs       01100100 10 0010 01 101 ... ..... .....  @rd_pg_rn_e0 !word=fp.cvt
FCVTNT_ds       01100100 11 0010 10 101 ... ..... .....  @rd_pg_rn_e0 !word=fp.cvt
FCVTLT_sd       01100100 11 0010 11 101 ... ..... .....  @rd_pg_rn_e0 !word=fp.cvt

### SVE2 floating-point convert to integer
FLOGB           01100101 00 011 esz:2 0101 pg:3 rn:5 rd:5  &rpr_esz !word=fp.mul

