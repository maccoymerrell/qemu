SMLALT_zzzw     01000100 .. 0 ..... 010 001 ..... .....  @rda_rn_rm !word=vec.madd
UMLALB_zzzw     01000100 .. 0 ..... 010 010 ..... .....  @rda_rn_rm !word=vec.madd
UMLALT_zzzw     01000100 .. 0 ..... 010 011 ..... .....  @rda_rn_rm !word=vec.madd
SMLSLB_zzzw     01000100 .. 0 ..... 010 100 ..... .....  @rda_rn_rm !word=vec.msub
SMLSLT_zzzw     01000100 .. 0 ..... 010 101 ..... .....  @rda_rn_rm !word=vec.msub
UMLSLB_zzzw     01000100 .. 0 ..... 010 110 ..... .....  @rda_rn_rm !word=vec.msub
UMLSLT_zzzw     01000100 .. 0 ..... 010 111 ..... .....  @rda_rn_rm !word=vec.msub

