+                const RegId &r = inst->destRegIdx(i);
+                if (i) outs << ",";
+                outs << r.className() << ":" << std::dec << r.index();
+            }
+            outs << "] SR=[";
+            for (int i = 0; i < inst->numSrcRegs(); ++i) {
+                const RegId &r = inst->srcRegIdx(i);
+                if (i) outs << ",";
+                outs << r.className() << ":" << std::dec << r.index();
+            }
+            outs << "]";
+        }
 
         if (debug::ExecFetchSeq && fetch_seq_valid)
             outs << "  FetchSeq=" << std::dec << fetch_seq;
@@ -175,6 +219,7 @@ ExeTracerRecord::dump()
     if (debug::ExecMicro || !staticInst->isMicroop()) {
