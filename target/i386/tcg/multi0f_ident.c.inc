static inline uint16_t multi0f_ident_of(int b, int modrm,
                                        int prefixes)
{
    bool repz  = (prefixes & PREFIX_REPZ) != 0;
    bool repnz = (prefixes & PREFIX_REPNZ) != 0;
    bool data  = (prefixes & PREFIX_DATA) != 0;

    for (size_t i = 0; i < ARRAY_SIZE(multi0f_ident_arms); i++) {
        if (multi0f_ident_arms[i].b != b) {
            continue;
        }
        switch (multi0f_ident_arms[i].pfx) {
        case M0F_PFX_NONE:
            if (repz || repnz || data) {
                continue;
            }
            break;
        case M0F_PFX_REPZ:
            if (!repz) {
                continue;
            }
            break;
        case M0F_PFX_REPNZ:
            if (!repnz) {
                continue;
            }
            break;
        case M0F_PFX_DATA:
            if (!data) {
                continue;
            }
            break;
        default:
            break;
        }
        if (multi0f_ident_arms[i].mem_only && ((modrm >> 6) & 3) == 3) {
            continue;
        }
        if ((modrm & multi0f_ident_arms[i].mask) ==
            multi0f_ident_arms[i].value) {
            return multi0f_ident_arms[i].idx;
        }
    }
    return 0;
}

/*
 * Publish the encoding-qualified identity for an arm that has one.
 * An encoding that reaches no arm publishes nothing and keeps what
 * the decode table's own row recorded.  Called on the path every
 * legal arm reaches and no illegal one does, so a #UD never gets an
 * identity for the instruction it was not.
 */
static inline void multi0f_ident_publish(int b, int modrm,
                                         int prefixes)
{
    uint16_t idx = multi0f_ident_of(b, modrm, prefixes);

    if (idx) {
        plugin_gen_record_insn_identity(multi0f_ident_tab[idx].id,
                                        multi0f_ident_tab[idx].name);
    }
}
