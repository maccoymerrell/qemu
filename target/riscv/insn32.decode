# *** Zimop may-be-operation extension ***
{
  # zicfiss instructions carved out of mop.r
  [
    ssrdp     1100110 11100 00000 100 rd:5  1110011 !word=mov
    sspopchk  1100110 11100 00001 100 00000 1110011 &r2 rs1=1 rd=0 !word=pop
    sspopchk  1100110 11100 00101 100 00000 1110011 &r2 rs1=5 rd=0 !word=pop
  ]
  mop_r_n    1 . 00 .. 0111 .. ..... 100 ..... 1110011 @mop5 !word=nop
}
{
  # zicfiss instruction carved out of mop.rr
  [
    sspush    1100111 00001  00000 100 00000 1110011 &r2_s rs2=1 rs1=0 !word=push
    sspush    1100111 00101  00000 100 00000 1110011 &r2_s rs2=5 rs1=0 !word=push
  ]
  mop_rr_n   1 . 00 .. 1 ..... ..... 100 ..... 1110011 @mop3 !word=nop
}

