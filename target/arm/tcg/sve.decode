BFDOT_zzxz      01100100 01 1 ..... 010000 ..... .....     @rrxr_2 esz=2 !word=vec.madd

### SVE broadcast predicate element

&psel           esz pd pn pm rv imm
%psel_rv        16:2 !function=plus_12
%psel_imm_b     22:2 19:2
%psel_imm_h     22:2 20:1
%psel_imm_s     22:2
%psel_imm_d     23:1
@psel           ........ .. . ... .. .. pn:4 . pm:4 . pd:4  \
                &psel rv=%psel_rv

PSEL            00100101 .. 1 ..1 .. 01 .... 0 .... 0 ....  \
                @psel esz=0 imm=%psel_imm_b !word=vec.logic
PSEL            00100101 .. 1 .10 .. 01 .... 0 .... 0 ....  \
                @psel esz=1 imm=%psel_imm_h !word=vec.logic
PSEL            00100101 .. 1 100 .. 01 .... 0 .... 0 ....  \
                @psel esz=2 imm=%psel_imm_s !word=vec.logic
PSEL            00100101 .1 1 000 .. 01 .... 0 .... 0 ....  \
                @psel esz=3 imm=%psel_imm_d !word=vec.logic

### SVE clamp

SCLAMP          01000100 .. 0 ..... 110000 ..... .....          @rda_rn_rm !word=vec.logic
UCLAMP          01000100 .. 0 ..... 110001 ..... .....          @rda_rn_rm !word=vec.logic
