# -*- Mode: makefile -*-
# RISC-V specific tweaks

VPATH += $(SRC_PATH)/tests/tcg/riscv64
TESTS += test-div
TESTS += noexec

# Disable compressed instructions for test-noc
TESTS += test-noc
test-noc: LDFLAGS = -nostdlib -static
run-test-noc: QEMU_OPTS += -cpu rv64,c=false

TESTS += test-aes
run-test-aes: QEMU_OPTS += -cpu rv64,zk=on

# Test for fcvtmod
TESTS += test-fcvtmod
test-fcvtmod: CFLAGS += -march=rv64imafdc
test-fcvtmod: LDFLAGS += -static
run-test-fcvtmod: QEMU_OPTS += -cpu rv64,d=true,zfa=true

# A host fault on a guest code read is a guest signal.  Zcmt's cm.jalt is
# the code read whose address the guest chooses; D is off because
# trans_c_fsd() otherwise claims the same encoding, and that rules out a
# lp64d libc, so the tests are freestanding.
SIGBUS_CODE_FETCH_CFLAGS = -march=rv64imac_zicsr -mabi=lp64

TESTS += test-sigbus-code-fetch
test-sigbus-code-fetch: CFLAGS += $(SIGBUS_CODE_FETCH_CFLAGS)
test-sigbus-code-fetch: LDFLAGS = -nostdlib -static
run-test-sigbus-code-fetch: QEMU_OPTS += -cpu rv64,d=false,zcmt=true

# The wrong-path half of the same rule needs a plugin driving a
# speculative excursion, which is what the ChampSim Tracer does.
ifeq ($(CONFIG_PLUGIN),y)
CHAMPSIM_TRACER = ../../../contrib/plugins/libchampsim_tracer.so
TESTS += test-sigbus-code-fetch-wp
test-sigbus-code-fetch-wp: CFLAGS += $(SIGBUS_CODE_FETCH_CFLAGS)
test-sigbus-code-fetch-wp: LDFLAGS = -nostdlib -static
run-test-sigbus-code-fetch-wp: QEMU_OPTS += -cpu rv64,d=false,zcmt=true \
	-plugin $(CHAMPSIM_TRACER)$(COMMA)outfile=sigbus-code-fetch-wp$(COMMA)wpdepth=64
endif

ifeq ($(CONFIG_PLUGIN),y)
# Wrong-path engine contract (tests/tcg/plugins/wp-assert.c): the plugin
# asserts in-process and aborts on a violation; the guest's output with
# the plugin must match its output without it.  The red controls live in
# the runner script described in the plugin's header.
TESTS += wp-victim
run-wp-victim: wp-victim libwp-assert.so
	$(call run-test, wp-victim.ref, env QEMU=$(QEMU) $(QEMU) $(QEMU_OPTS) ./$<, \
		wp-victim without plugin)
	$(call run-test, $<, env QEMU=$(QEMU) $(QEMU) $(QEMU_OPTS) \
		-plugin $(PLUGIN_LIB)/libwp-assert.so$(COMMA)require=on $<, \
		wp-victim with wp-assert)
	$(call diff-out, $<, wp-victim.ref.out)
endif
