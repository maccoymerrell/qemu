mul      0000001 .....  ..... 000 ..... 0110011 @r !word=int.mul
mulh     0000001 .....  ..... 001 ..... 0110011 @r !word=int.mul
mulhsu   0000001 .....  ..... 010 ..... 0110011 @r !word=int.mul
