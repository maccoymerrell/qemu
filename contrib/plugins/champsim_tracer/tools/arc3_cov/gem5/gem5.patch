-        if (debug::ExecEffAddr && getMemValid())
+        if (debug::ExecEffAddr && getMemValid()) {
             outs << " A=0x" << std::hex << addr;
+            outs << " S=" << std::dec << size;
+            outs << " MF=0x" << std::hex << flags;
+        }
+
+        // ARC 3 execution-reference addition (ChampSim Tracer cross-check):
+        // name the architectural registers this instruction reads and writes,
+        // so a consumer does not have to recover them from disassembly text.
+        // Gated on ExecRegDelta, which the ExeTracer otherwise ignores.
+        if (debug::ExecRegDelta) {
+            outs << " RW=[";
+            for (size_t i = 0; i < arc3::regWrites.size(); ++i) {
+                const arc3::RegWrite &w = arc3::regWrites[i];
+                if (i) outs << ",";
+                outs << w.cls << ":" << std::dec << w.idx << "=";
+                if (w.valued)
+                    ccprintf(outs, "0x%x", w.val);
+                else
