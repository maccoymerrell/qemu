diff --git a/src/cpu/arc3_trace.hh b/src/cpu/arc3_trace.hh
new file mode 100644
index 0000000..8245f6c
--- /dev/null
+++ b/src/cpu/arc3_trace.hh
@@ -0,0 +1,67 @@
+/*
+ * ARC 3 execution-reference sidecar (ChampSim Tracer cross-check).
+ *
+ * gem5's InstRecord carries ONE data word, written by whichever destination
+ * wrote last, so a micro-op with several destinations -- ldp, a flag-setting
+ * ALU op, an FP convert that also updates FPSR -- publishes a value for one of
+ * them and silently none for the rest.  A consumer that pairs that word with
+ * the FIRST destination, or with the last, is right some of the time and wrong
+ * the rest, and its errors read as tracer defects.
+ *
+ * This sidecar records EVERY architectural destination write with its value,
+ * plus the bytes a memory access moved, and the ExeTracer prints them.  It is
+ * a plain global rather than a member of InstRecord so that adding it does not
+ * rebuild the whole tree; that is sound only for a CPU model that executes one
+ * instruction at a time to completion, which is what this cross-check runs
+ * (AtomicSimpleCPU).  Any out-of-order model would interleave writers here.
+ *
+ * Author: Maccoy Merrell.
+ */
+#ifndef __CPU_ARC3_TRACE_HH__
+#define __CPU_ARC3_TRACE_HH__
+
+#include <cstdint>
+#include <vector>
+
+namespace gem5
+{
+namespace arc3
+{
+
+struct RegWrite
+{
+    const char *cls;
+    int idx;
+    uint64_t val;
+    bool valued;        // false when the datum is wider than 64 bits
+};
+
+extern std::vector<RegWrite> regWrites;
+extern uint64_t memData;
+extern bool memDataValid;
+
+inline void
+addRegWrite(const char *cls, int idx, uint64_t val, bool valued)
+{
+    regWrites.push_back(RegWrite{cls, idx, val, valued});
+}
+
+inline void
+setMemData(uint64_t v)
+{
+    memData = v;
+    memDataValid = true;
+}
+
+inline void
+clear()
+{
+    regWrites.clear();
+    memDataValid = false;
+    memData = 0;
+}
+
+} // namespace arc3
+} // namespace gem5
+
+#endif // __CPU_ARC3_TRACE_HH__
