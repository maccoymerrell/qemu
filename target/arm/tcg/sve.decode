USDOT_zzzz      01000100 .. 0 ..... 011 110 ..... .....  @rda_rn_rm !word=vec.madd

### SVE2 floating point matrix multiply accumulate
BFMMLA          01100100 01 1 ..... 111 001 ..... .....  @rda_rn_rm_e0 !word=fp.madd
FMMLA_s         01100100 10 1 ..... 111 001 ..... .....  @rda_rn_rm_e0 !word=fp.madd
FMMLA_d         01100100 11 1 ..... 111 001 ..... .....  @rda_rn_rm_e0 !word=fp.madd

### SVE2 Memory Gather Load Group

# SVE2 64-bit gather non-temporal load (scalar plus 64-bit unscaled offsets)
LDNT1_zprz      1100010 msz:2 00 rm:5 1 u:1 0 pg:3 rn:5 rd:5 \
                &rprr_gather_load xs=2 esz=3 scale=0 ff=0 !word=vec.load

# SVE2 32-bit gather non-temporal load (scalar plus 32-bit unscaled offsets)
LDNT1_zprz      1000010 msz:2 00 rm:5 10 u:1 pg:3 rn:5 rd:5 \
                &rprr_gather_load xs=0 esz=2 scale=0 ff=0 !word=vec.load

### SVE2 Memory Store Group

# SVE2 64-bit scatter non-temporal store (vector plus scalar)
STNT1_zprz      1110010 .. 00 ..... 001 ... ..... ..... \
                @rprr_scatter_store xs=2 esz=3 scale=0 !word=vec.store

# SVE2 32-bit scatter non-temporal store (vector plus scalar)
STNT1_zprz      1110010 .. 10 ..... 001 ... ..... ..... \
                @rprr_scatter_store xs=0 esz=2 scale=0 !word=vec.store

### SVE2 Crypto Extensions

# SVE2 crypto unary operations
AESMC           01000101 00 10000011100 0 00000 rd:5 !word=vec.logic
AESIMC          01000101 00 10000011100 1 00000 rd:5 !word=vec.logic

# SVE2 crypto destructive binary operations
AESE            01000101 00 10001 0 11100 0 ..... .....  @rdn_rm_e0 !word=vec.logic
AESD            01000101 00 10001 0 11100 1 ..... .....  @rdn_rm_e0 !word=vec.logic
SM4E            01000101 00 10001 1 11100 0 ..... .....  @rdn_rm_e0 !word=vec.logic

# SVE2 crypto constructive binary operations
SM4EKEY         01000101 00 1 ..... 11110 0 ..... .....  @rd_rn_rm_e0 !word=vec.logic
RAX1            01000101 00 1 ..... 11110 1 ..... .....  @rd_rn_rm_e0 !word=vec.logic

