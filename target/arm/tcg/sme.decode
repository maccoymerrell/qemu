### SME Misc

ZERO            11000000 00 001 00000000000 imm:8 !word=vec.logic

### SME Move into/from Array

%mova_rs        13:2 !function=plus_12
&mova           esz rs pg zr za_imm v:bool to_vec:bool

MOVA            11000000 esz:2 00000 0 v:1 .. pg:3 zr:5 0 za_imm:4  \
                &mova to_vec=0 rs=%mova_rs !word=vec.mov
MOVA            11000000 11    00000 1 v:1 .. pg:3 zr:5 0 za_imm:4  \
                &mova to_vec=0 rs=%mova_rs esz=4 !word=vec.mov

MOVA            11000000 esz:2 00001 0 v:1 .. pg:3 0 za_imm:4 zr:5  \
                &mova to_vec=1 rs=%mova_rs !word=vec.mov
MOVA            11000000 11    00001 1 v:1 .. pg:3 0 za_imm:4 zr:5  \
                &mova to_vec=1 rs=%mova_rs esz=4 !word=vec.mov

### SME Memory

&ldst           esz rs pg rn rm za_imm v:bool st:bool

LDST1           1110000 0 esz:2 st:1 rm:5 v:1 .. pg:3 rn:5 0 za_imm:4  \
                &ldst rs=%mova_rs !word=vec.load
LDST1           1110000 111     st:1 rm:5 v:1 .. pg:3 rn:5 0 za_imm:4  \
                &ldst esz=4 rs=%mova_rs !word=vec.load

&ldstr          rv rn imm
@ldstr          ....... ... . ...... .. ... rn:5 . imm:4 \
                &ldstr rv=%mova_rs

LDR             1110000 100 0 000000 .. 000 ..... 0 ....        @ldstr !word=load
STR             1110000 100 1 000000 .. 000 ..... 0 ....        @ldstr !word=store

### SME Add Vector to Array

&adda           zad zn pm pn
@adda_32        ........ .. ..... . pm:3 pn:3 zn:5 ... zad:2    &adda
@adda_64        ........ .. ..... . pm:3 pn:3 zn:5 ..  zad:3    &adda

ADDHA_s         11000000 10 01000 0 ... ... ..... 000 ..        @adda_32 !word=int.add
ADDVA_s         11000000 10 01000 1 ... ... ..... 000 ..        @adda_32 !word=vec.add
ADDHA_d         11000000 11 01000 0 ... ... ..... 00 ...        @adda_64 !word=int.add
ADDVA_d         11000000 11 01000 1 ... ... ..... 00 ...        @adda_64 !word=vec.add

### SME Outer Product

&op             zad zn zm pm pn sub:bool
@op_32          ........ ... zm:5 pm:3 pn:3 zn:5 sub:1 .. zad:2 &op
@op_64          ........ ... zm:5 pm:3 pn:3 zn:5 sub:1 .  zad:3 &op

FMOPA_s         10000000 100 ..... ... ... ..... . 00 ..        @op_32 !word=fp.madd
FMOPA_d         10000000 110 ..... ... ... ..... . 0 ...        @op_64 !word=fp.madd

BFMOPA          10000001 100 ..... ... ... ..... . 00 ..        @op_32 !word=fp.madd
FMOPA_h         10000001 101 ..... ... ... ..... . 00 ..        @op_32 !word=fp.madd

SMOPA_s         1010000 0 10 0 ..... ... ... ..... . 00 ..      @op_32 !word=vec.madd
SUMOPA_s        1010000 0 10 1 ..... ... ... ..... . 00 ..      @op_32 !word=vec.madd
USMOPA_s        1010000 1 10 0 ..... ... ... ..... . 00 ..      @op_32 !word=vec.madd
UMOPA_s         1010000 1 10 1 ..... ... ... ..... . 00 ..      @op_32 !word=vec.madd

SMOPA_d         1010000 0 11 0 ..... ... ... ..... . 0 ...      @op_64 !word=vec.madd
SUMOPA_d        1010000 0 11 1 ..... ... ... ..... . 0 ...      @op_64 !word=vec.madd
USMOPA_d        1010000 1 11 0 ..... ... ... ..... . 0 ...      @op_64 !word=vec.madd
UMOPA_d         1010000 1 11 1 ..... ... ... ..... . 0 ...      @op_64 !word=vec.madd
