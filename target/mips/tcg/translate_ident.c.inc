/*
 * ENCODING-QUALIFIED SUB-RULES.  One case label, several
 * architectural instructions, told apart by fixed encoding
 * bits -- MIPS puts its execution hints inside the SLL
 * encoding, and MASK_SPECIAL() masks the deciding fields
 * off before the switch sees them.  The discriminator is
 * the instruction word and nothing else; an encoding that
 * matches no qualification keeps the base rule's own
 * identity, unchanged.
 */
static inline MipsIdent mips_ident_q_OPC_SLL(uint32_t insn)
{
    /* NOP -- SLL r0,r0,0 */
    if ((insn & 0xffffffffu) == 0x00000000u) {
        return MIPS_ID_OPC_SLL__Q0;
    }
    /* SSNOP -- SLL r0,r0,1 */
    if ((insn & 0xffffffffu) == 0x00000040u) {
        return MIPS_ID_OPC_SLL__Q1;
    }
    /* EHB -- SLL r0,r0,3 */
    if ((insn & 0xffffffffu) == 0x000000c0u) {
        return MIPS_ID_OPC_SLL__Q2;
    }
    /* PAUSE -- SLL r0,r0,5, and QEMU names this one itself at the OPC_SLL */
    /* arm of decode_opc_special */
    if ((insn & 0xffffffffu) == 0x00000140u) {
        return MIPS_ID_OPC_SLL__Q3;
    }
    return MIPS_ID_OPC_SLL;
}
