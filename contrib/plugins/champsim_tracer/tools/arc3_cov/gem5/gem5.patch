@@ -59,6 +63,21 @@
 namespace gem5
 {
 
+/*
+ * ARC 3 execution-reference markers (ChampSim Tracer cross-check).
+ *
+ * The ExeTracer record carries an address, a size and the Request flags, and
+ * nothing that says which DIRECTION the access went.  Recovering it from the
+ * OpClass is not enough: a read-modify-write micro-op carries exactly one
+ * OpClass and performs both halves, so the OpClass would silently drop one of
+ * them.  These three bits are unused by Request::Flags and are set at the
+ * three call sites that know the answer.
+ */
+static constexpr Request::FlagsType ARC3_READ  = 0x4000000000000000ULL;
+static constexpr Request::FlagsType ARC3_WRITE = 0x8000000000000000ULL;
+static constexpr Request::FlagsType ARC3_AMO   = 0x2000000000000000ULL;
+
+
 void
 AtomicSimpleCPU::init()
 {
@@ -367,7 +386,7 @@ AtomicSimpleCPU::readMem(Addr addr, uint8_t *data, unsigned size,
     const RequestPtr &req = data_read_req;
 
     if (traceData)
-        traceData->setMem(addr, size, flags);
+        traceData->setMem(addr, size, flags | ARC3_READ);
 
     dcache_latency = 0;
 
@@ -452,8 +471,20 @@ AtomicSimpleCPU::writeMem(uint8_t *data, unsigned size, Addr addr,
     // use the CPU's statically allocated write request and packet objects
     const RequestPtr &req = data_write_req;
 
-    if (traceData)
-        traceData->setMem(addr, size, flags);
+    if (traceData) {
+        traceData->setMem(addr, size, flags | ARC3_WRITE);
+        // ARC 3 execution-reference addition (ChampSim Tracer cross-check):
+        // a store micro-op has no destination register, so the ExeTracer's
+        // D= field is otherwise unset for it and the STORED VALUE never
+        // reaches the log.  Publish it here, where the bytes are in hand.
+        // Only widths the record's 64-bit data word can hold are published;
+        // a wider store leaves D= unset rather than publishing a truncation.
+        if (size <= 8) {
+            uint64_t sd = 0;
+            std::memcpy(&sd, data, size);
+            arc3::setMemData(sd);
+        }
+    }
 
     dcache_latency = 0;
 
@@ -553,7 +584,7 @@ AtomicSimpleCPU::amoMem(Addr addr, uint8_t* data, unsigned size,
     const RequestPtr &req = data_amo_req;
 
     if (traceData)
-        traceData->setMem(addr, size, flags);
+        traceData->setMem(addr, size, flags | ARC3_AMO);
 
     //The address of the second part of this access if it needs to be split
     //across a cache line boundary.
